PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/guess_the_gif
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bot Player Configuration
# Required: shared secret for bot internal socket auth (generate a random string)
BOT_INTERNAL_SECRET=your-bot-internal-secret-here
# Enable/disable bot system entirely (default: true)
BOT_ENABLED=true
# How often to check for eligible lobbies in milliseconds (default: 10000)
BOT_POLL_INTERVAL_MS=10000
# Time a lobby must wait before bots join in milliseconds (default: 30000)
BOT_LOBBY_WAIT_THRESHOLD_MS=30000
# Time before auto-starting with bots in milliseconds (default: 60000)
BOT_AUTO_START_THRESHOLD_MS=60000
# Maximum number of bots per lobby (default: 2)
BOT_MAX_PER_LOBBY=2
# Number of bot records per personality tier
BOT_POOL_NOVICE=2
BOT_POOL_INTERMEDIATE=2
BOT_POOL_EXPERT=2
